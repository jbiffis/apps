# Top-level secrets — never commit
.env
.env.local
*.env

# Tracker dev artifacts (per-subdir .gitignores cover most; belt-and-braces)
tracker/.local-data/
tracker/backend/target/
tracker/frontend/node_modules/
# NOTE: tracker/frontend/dist/ is intentionally committed (like book-log,
# dreamworld) so the restart-only Komodo deploy can bind-mount the build into
# the shared Apache. Rebuild + commit dist after frontend changes.
tracker/**/*.db
tracker/**/*.sqlite*
tracker/**/dump.sql

# Editor / OS
.DS_Store
.idea/
*.iml
.vscode/
